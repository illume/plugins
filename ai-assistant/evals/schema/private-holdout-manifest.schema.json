{
  "$id": "https://headlamp-k8s.local/evals/schema/private-holdout-manifest.schema.json",
  "schema_version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "created_at", "scenario_ids"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "created_at": { "type": "string", "minLength": 1 },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
