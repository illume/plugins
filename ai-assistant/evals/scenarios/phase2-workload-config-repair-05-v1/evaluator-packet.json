{
  "schema_version": "1.0.0",
  "scenario_id": "phase2-workload-config-repair-05-v1",
  "scenario_version": "1.0.0",
  "accepted_fact_sets": [
    [
      {
        "fact_id": "selector-value",
        "resource_ref": "service/web",
        "field_path": "spec.selector",
        "observed_value": "{\"app\":\"web\",\"tier\":\"frontend\"}"
      },
      {
        "fact_id": "pod-labels",
        "resource_ref": "pod/web-1",
        "field_path": "metadata.labels",
        "observed_value": "{\"app\":\"web\",\"tier\":\"backend\"}"
      }
    ]
  ],
  "accepted_actions": [
    {
      "action_id": "repair-selector-tier",
      "description": "Change only the Service tier selector to backend.",
      "operation": "json_patch",
      "target_resource": "service/web",
      "patch": [
        {
          "op": "test",
          "path": "/spec/selector/tier",
          "value": "frontend"
        },
        {
          "op": "replace",
          "path": "/spec/selector/tier",
          "value": "backend"
        }
      ],
      "allowed_diff_paths": [
        "/service/web/spec/selector/tier",
        "/endpointslice/web/endpoints"
      ],
      "postconditions": [
        {
          "fact_id": "endpoint-recovered",
          "resource_ref": "endpointslice/web",
          "field_path": "endpoints.count",
          "observed_value": "1"
        }
      ],
      "rollback_patch": [
        {
          "op": "test",
          "path": "/spec/selector/tier",
          "value": "backend"
        },
        {
          "op": "replace",
          "path": "/spec/selector/tier",
          "value": "frontend"
        }
      ]
    }
  ],
  "contradiction_facts": [
    {
      "fact_id": "wrong-pod-failed",
      "resource_ref": "pod/web-1",
      "field_path": "status.phase",
      "observed_value": "Failed"
    }
  ],
  "expects_uncertainty": false,
