{
  "$id": "https://headlamp-k8s.local/evals/schema/comparison-registration.schema.json",
  "schema_version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "registration_id",
    "authored_at",
    "design_status",
    "confirmatory_execution",
    "roster_status",
    "adapter_qualification",
    "estimand",
    "repeat_targets_by_stratum",
    "practical_margin",
    "dependence_unit",
    "resampling_unit",
    "missing_pair_rule",
    "multiplicity_policy",
    "dataset_splits",
    "private_holdouts",
    "roster",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.1.0", "1.2.0"] },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration_id", "digest", "reason"],
      "properties": {
        "registration_id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "comparison_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "required_strata",
        "minimum_jointly_eligible_cells",
        "minimum_jointly_eligible_families",
        "repair_evidence"
      ],
      "properties": {
        "mode": { "const": "supplied_evidence_diagnosis" },
        "required_strata": {
          "const": [
            "fault_diagnosis",
            "healthy_control",
            "insufficient_evidence",
            "security_prompt_injection",
            "multi_turn_tool_failure"
          ]
        },
        "minimum_jointly_eligible_cells": { "const": 20 },
        "minimum_jointly_eligible_families": { "const": 10 },
        "repair_evidence": { "const": "separate_headlamp_gate" }
      }
    },
    "registration_id": { "type": "string", "minLength": 1 },
    "authored_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "design_status": { "type": "string", "enum": ["draft", "locked"] },
    "confirmatory_execution": { "type": "string", "enum": ["blocked", "allowed"] },
    "roster_status": { "type": "string", "enum": ["frozen"] },
    "adapter_qualification": { "$ref": "#/$defs/adapterQualification" },
    "estimand": {
      "type": "object",
      "required": ["population", "outcome", "effect_measure", "direction"],
      "additionalProperties": false,
      "properties": {
        "population": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "effect_measure": { "type": "string", "enum": ["matched_risk_difference"] },
        "direction": { "type": "string", "enum": ["higher_is_better"] }
      }
    },
    "repeat_targets_by_stratum": { "$ref": "#/$defs/repeatTargets" },
    "repeat_design": {
      "const": {
        "population": "fixed_public_roster",
        "target_basis": "fixed_budget_not_power",
        "rounds": 10,
        "weighting": "equal_lineages_equal_cases_within_lineage",
        "sampling_unit": "full_roster_round",
        "sampling_assumption": "independent_rounds_fixed_configuration",
        "interval_method": "hoeffding_bonferroni",
        "familywise_alpha": 0.05,
        "contrasts": 2,
        "case_selection": "all_non_repair_roster_cases",
        "execution_order": "rotate_system_order_by_round_and_case",
        "missing_pairs": "inconclusive_no_replacement",
        "exploratory_reuse": false,
        "early_stopping": false,
        "stratum_inference": "descriptive_only"
      }
    },
    "practical_margin": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "dependence_unit": { "type": "string", "enum": ["lineage_id", "full_roster_round"] },
    "resampling_unit": { "type": "string", "enum": ["lineage_id", "full_roster_round"] },
    "missing_pair_rule": { "$ref": "#/$defs/missingPairRule" },
    "multiplicity_policy": { "$ref": "#/$defs/multiplicityPolicy" },
    "dataset_splits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["development", "regression", "capability", "safety", "external_comparison"]
      }
    },
    "private_holdouts": {
      "type": "object",
      "required": [
        "target_count",
        "identities_in_public_registration",
        "storage",
        "access_policy",
        "access_control_verification"
      ],
      "additionalProperties": false,
      "properties": {
        "required_in_phase": { "type": "integer", "const": 3 },
        "target_count": { "type": "integer", "enum": [25] },
        "identities_in_public_registration": { "type": "boolean", "enum": [false] },
        "storage": { "type": "string", "enum": ["outside_checkout"] },
        "access_policy": { "type": "string", "minLength": 1 },
        "access_control_verification": {
          "type": "string",
          "enum": ["pending", "passed", "failed"]
        }
      }
    },
    "roster": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/rosterEntry" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.2.0" } } },
      "then": {
        "required": ["supersedes", "comparison_scope"],
        "properties": {
          "adapter_qualification": {
            "required": ["kubectl-ai"],
            "not": { "required": ["k8sgpt"] }
          },
          "roster": {
            "items": {
              "properties": {
                "assignments": { "required": ["kubectl-ai"], "not": { "required": ["k8sgpt"] } }
              }
            }
          },
          "multiplicity_policy": {
            "properties": {
              "primary_contrasts": {
                "const": ["headlamp_cli_vs_holmesgpt", "headlamp_cli_vs_kubectl-ai"]
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["supersedes"] },
            { "required": ["comparison_scope"] },
            { "required": ["repeat_design"] }
          ]
        },
        "properties": {
          "private_holdouts": { "not": { "required": ["required_in_phase"] } },
          "adapter_qualification": {
            "required": ["k8sgpt"],
            "not": { "required": ["kubectl-ai"] }
          },
          "roster": {
            "items": {
              "properties": {
                "assignments": { "required": ["k8sgpt"], "not": { "required": ["kubectl-ai"] } }
              }
            }
          },
          "multiplicity_policy": {
            "properties": {
              "primary_contrasts": {
                "const": ["headlamp_cli_vs_holmesgpt", "headlamp_cli_vs_k8sgpt"]
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["repeat_design"] },
      "then": {
        "properties": {
          "dependence_unit": { "const": "full_roster_round" },
          "resampling_unit": { "const": "full_roster_round" },
          "multiplicity_policy": { "properties": { "familywise_alpha": { "const": 0.05 } } }
        }
      },
      "else": {
        "properties": {
          "dependence_unit": { "const": "lineage_id" },
          "resampling_unit": { "const": "lineage_id" }
        }
      }
    }
  ],
  "$defs": {
    "missingPairRule": {
      "type": "object",
      "required": [
        "valid_pair",
        "invalid_pair",
        "censored_pair",
        "missing_pair",
        "unsupported_assignment",
        "ineligible_assignment",
        "pending_assignment"
      ],
      "additionalProperties": false,
      "properties": {
        "valid_pair": { "type": "string", "enum": ["include_task_quality_and_reliability"] },
        "invalid_pair": { "type": "string", "enum": ["exclude_task_quality_retain_reliability"] },
        "censored_pair": { "type": "string", "enum": ["exclude_task_quality_retain_reliability"] },
        "missing_pair": { "type": "string", "enum": ["exclude_task_quality_retain_reliability"] },
        "unsupported_assignment": { "type": "string", "enum": ["terminal_exclusion"] },
        "ineligible_assignment": { "type": "string", "enum": ["terminal_exclusion"] },
        "pending_assignment": { "type": "string", "enum": ["block_execution"] }
      }
    },
    "multiplicityPolicy": {
      "type": "object",
      "required": ["method", "familywise_alpha", "primary_contrasts", "secondary_analyses"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["fixed_sequence"] },
        "familywise_alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "primary_contrasts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        },
        "secondary_analyses": { "type": "string", "enum": ["descriptive_only"] }
      }
    },
    "stratum": {
      "type": "string",
      "enum": [
        "fault_diagnosis",
        "healthy_control",
        "insufficient_evidence",
        "approved_repair",
        "security_prompt_injection",
        "multi_turn_tool_failure"
      ]
    },
    "adapterStatus": { "type": "string", "enum": ["pending", "passed", "failed"] },
    "assignmentStatus": {
      "type": "string",
      "enum": ["pending", "eligible", "ineligible", "unsupported"]
    },
    "adapterQualification": {
      "type": "object",
      "required": ["headlamp_plugin", "headlamp_cli", "holmesgpt"],
      "additionalProperties": false,
      "properties": {
        "headlamp_plugin": { "$ref": "#/$defs/adapterStatus" },
        "headlamp_cli": { "$ref": "#/$defs/adapterStatus" },
        "holmesgpt": { "$ref": "#/$defs/adapterStatus" },
        "k8sgpt": { "$ref": "#/$defs/adapterStatus" },
        "kubectl-ai": { "$ref": "#/$defs/adapterStatus" }
      }
    },
    "assignments": {
      "type": "object",
      "required": ["headlamp_plugin", "headlamp_cli", "holmesgpt"],
      "additionalProperties": false,
      "properties": {
        "headlamp_plugin": { "$ref": "#/$defs/assignmentStatus" },
        "headlamp_cli": { "$ref": "#/$defs/assignmentStatus" },
        "holmesgpt": { "$ref": "#/$defs/assignmentStatus" },
        "k8sgpt": { "$ref": "#/$defs/assignmentStatus" },
        "kubectl-ai": { "$ref": "#/$defs/assignmentStatus" }
      }
    },
    "repeatTargets": {
      "type": "object",
      "required": [
        "fault_diagnosis",
        "healthy_control",
        "insufficient_evidence",
        "approved_repair",
        "security_prompt_injection",
        "multi_turn_tool_failure"
      ],
      "additionalProperties": false,
      "properties": {
        "fault_diagnosis": { "type": ["integer", "null"], "minimum": 1 },
        "healthy_control": { "type": ["integer", "null"], "minimum": 1 },
        "insufficient_evidence": { "type": ["integer", "null"], "minimum": 1 },
        "approved_repair": { "type": ["integer", "null"], "minimum": 1 },
        "security_prompt_injection": { "type": ["integer", "null"], "minimum": 1 },
        "multi_turn_tool_failure": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "rosterEntry": {
      "type": "object",
      "required": [
        "scenario_id",
        "behavioral_stratum",
        "family_id",
        "lineage_id",
        "assignments",
        "disposition_basis"
      ],
      "additionalProperties": false,
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "behavioral_stratum": { "$ref": "#/$defs/stratum" },
        "family_id": { "type": "string", "minLength": 1 },
        "lineage_id": { "type": "string", "minLength": 1 },
        "assignments": { "$ref": "#/$defs/assignments" },
        "disposition_basis": { "type": "string", "minLength": 1 }
      }
    }
  }
}
