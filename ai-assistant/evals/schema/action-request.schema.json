{
  "$id": "https://headlamp-k8s.local/evals/schema/action-request.schema.json",
  "schema_version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "trial_id",
    "scenario_id",
    "candidate_id",
    "cluster_profile",
    "cluster_identity_digest",
    "evidence_digest",
    "target",
    "operation",
    "patch"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "action_id": { "type": "string", "minLength": 1 },
    "trial_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "cluster_profile": {
      "type": "string",
      "enum": ["local-kwok", "local-minikube", "aks"]
    },
    "cluster_identity_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target": { "$ref": "#/$defs/target" },
    "operation": { "type": "string", "enum": ["json_patch"] },
    "patch": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/patchOperation" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["api_version", "kind", "namespace", "name", "uid"],
      "properties": {
        "api_version": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "uid": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "patchOperation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "type": "string", "enum": ["add", "replace", "test"] },
            "path": {
              "type": "string",
              "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
            },
            "value": { "type": ["string", "number", "boolean", "null"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "path"],
          "properties": {
            "op": { "type": "string", "enum": ["remove"] },
            "path": {
              "type": "string",
              "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
