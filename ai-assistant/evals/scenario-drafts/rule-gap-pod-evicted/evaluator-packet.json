      {
        "fact_id": "pod-evicted",
        "resource_ref": "pod/storage-pressure",
        "field_path": "status.reason",
        "observed_value": "Evicted",
        "description": "Kubelet terminated the Pod through eviction."
      },
      {
        "fact_id": "ephemeral-storage-limit-exceeded",
        "resource_ref": "pod/storage-pressure",
        "field_path": "status.message",
        "observed_value": "<contains: ephemeral-storage>",
        "description": "The terminal message attributes eviction to local ephemeral-storage usage."
      },
      {
        "fact_id": "eviction-counter-increase",
        "resource_ref": "metric/kubelet_evictions{eviction_signal=\"ephemeral_storage\"}",
        "field_path": "increase[10m]",
        "observed_value": "> 0",
        "description": "The kubelet eviction counter increases in the same observation window."
      }
    ]
  ],
  "accepted_actions": [
    { "action_id": "no-op", "description": "Read-only diagnosis only.", "operation": "no_action" }
  ],
  "contradiction_facts": [
