{
  "$id": "https://headlamp-k8s.local/evals/schema/tool-rule-inventory.schema.json",
  "schema_version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "scope",
    "review_status",
    "methodology",
    "total_tools",
    "total_rules",
    "total_semantic_groups",
    "tools"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date" },
    "scope": { "type": "string", "minLength": 1 },
    "review_status": { "enum": ["provisional", "reviewed"] },
    "methodology": {
      "type": "object",
      "required": [
        "inventory_unit",
        "semantic_grouping",
        "derived_id_algorithm",
        "reproducibility"
      ],
      "properties": {
        "inventory_unit": { "type": "string", "minLength": 1 },
        "semantic_grouping": { "type": "string", "minLength": 1 },
        "derived_id_algorithm": { "type": "string", "minLength": 1 },
        "reproducibility": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "total_tools": { "type": "integer", "minimum": 1 },
    "total_rules": { "type": "integer", "minimum": 1 },
    "total_semantic_groups": { "type": "integer", "minimum": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool_id",
          "name",
          "repository",
          "revision",
          "native_unit",
          "id_origin",
          "mapping_readiness",
          "extraction_method",
          "inventory_caveat",
          "rule_count",
          "semantic_group_count",
          "rules"
        ],
        "properties": {
          "tool_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "format": "uri" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "native_unit": { "type": "string", "minLength": 1 },
          "id_origin": {
            "enum": ["native", "derived"],
            "description": "Whether the semantic identifier comes from the source or is derived; every inventory rule_id remains namespaced by this dataset."
          },
          "mapping_readiness": {
            "enum": ["direct_predicate", "requires_decomposition", "reference_only"]
          },
          "extraction_method": { "type": "string", "minLength": 1 },
          "inventory_caveat": { "type": "string", "minLength": 1 },
          "rule_count": { "type": "integer", "minimum": 1 },
          "semantic_group_count": { "type": "integer", "minimum": 1 },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "rule_id",
                "semantic_group_id",
                "title",
                "summary",
                "summary_origin",
                "source_path",
                "info_url",
                "id_origin"
              ],
              "properties": {
                "rule_id": { "type": "string", "minLength": 3 },
                "semantic_group_id": { "type": "string", "minLength": 3 },
                "title": { "type": "string", "minLength": 1 },
                "summary": { "type": "string", "minLength": 3, "maxLength": 320 },
                "summary_origin": { "enum": ["native", "derived"] },
                "source_path": { "type": "string", "minLength": 1 },
                "info_url": { "type": "string", "format": "uri" },
                "upstream_url": { "type": "string", "format": "uri" },
                "id_origin": { "enum": ["native", "derived"] }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
