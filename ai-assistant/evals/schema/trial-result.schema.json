{
  "$id": "https://headlamp-k8s.local/evals/schema/trial-result.schema.json",
  "schema_version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "trial_id",
    "run_id",
    "scenario_id",
    "scenario_version",
    "candidate_id",
    "candidate_kind",
    "execution_mode",
    "cluster_profile",
    "run_eligibility",
    "stage_status",
    "dimensions",
    "safety_outcome",
    "safety_events",
    "lifecycle_validity",
    "timing",
    "tool_summary",
    "model_usage",
    "model_invocations",
    "configured_usage_estimate",
    "submission_status",
    "unscored_novel_strategy",
    "supersedes_trial_id",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "trial_id": { "type": "string" },
    "run_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "scenario_version": { "type": "string" },
    "candidate_id": { "type": "string" },
    "candidate_kind": {
      "type": "string",
      "enum": ["scripted", "headlamp-cli", "reference-system"]
    },
    "execution_mode": { "type": "string", "enum": ["dry-run", "real"] },
    "cluster_profile": { "type": "string" },
    "run_eligibility": {
      "type": "string",
      "enum": ["valid", "invalid", "inconclusive", "quarantined"]
    },
    "first_failure_owner": { "type": "string" },
    "stage_status": {
      "type": "object",
      "required": ["setup", "candidate", "grader", "verifier", "cleanup"],
      "properties": {
        "setup": { "$ref": "#/$defs/operationStatus" },
        "candidate": { "$ref": "#/$defs/operationStatus" },
        "grader": { "$ref": "#/$defs/operationStatus" },
        "verifier": { "$ref": "#/$defs/operationStatus" },
        "cleanup": { "$ref": "#/$defs/operationStatus" }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": ["root_cause", "recommended_fix", "executed_repair"],
      "properties": {
        "root_cause": { "$ref": "#/$defs/dimensionResult" },
        "recommended_fix": { "$ref": "#/$defs/dimensionResult" },
        "executed_repair": { "$ref": "#/$defs/dimensionResult" }
      },
      "additionalProperties": false
    },
    "safety_outcome": { "type": "string", "enum": ["pass", "fail", "unknown", "not_applicable"] },
    "safety_events": { "type": "array", "items": { "type": "string" } },
    "lifecycle_validity": { "type": "string" },
    "timing": {
      "type": "object",
      "required": ["time_to_diagnosis_ns", "time_to_resolution_ns"],
      "properties": {
        "time_to_diagnosis_ns": {
          "oneOf": [{ "type": "string", "pattern": "^\\d+$" }, { "type": "null" }]
        },
        "time_to_resolution_ns": { "type": "null" },
        "diagnosis_started_at": { "type": "string" },
        "diagnosis_completed_at": { "type": "string" },
        "censoring_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tool_summary": {
      "type": "object",
      "required": [
        "attempted",
        "completed",
        "failed",
        "denied",
        "unique_tools",
        "total_duration_ns"
      ],
      "properties": {
        "attempted": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "denied": { "type": "integer", "minimum": 0 },
        "unique_tools": { "type": "integer", "minimum": 0 },
        "total_duration_ns": { "type": "string", "pattern": "^\\d+$" }
      },
      "additionalProperties": false
    },
    "model_usage": {
      "type": ["object", "null"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "uncached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "request_count": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_5m_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_1h_input_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_output_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "input_tokens",
        "uncached_input_tokens",
        "output_tokens",
        "total_tokens",
        "request_count"
      ],
      "additionalProperties": false
    },
    "model_invocations": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "input_token_semantics": {
            "type": "string",
            "enum": ["total_including_cache", "uncached_only"]
          },
          "model": { "type": "string", "minLength": 1 },
          "service_tier": { "type": "string", "minLength": 1 },
          "inference_geo": { "type": "string", "minLength": 1 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "uncached_input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
          "cache_write_input_tokens": { "type": "integer", "minimum": 0 },
          "cache_write_5m_input_tokens": { "type": "integer", "minimum": 0 },
          "cache_write_1h_input_tokens": { "type": "integer", "minimum": 0 },
          "reasoning_output_tokens": { "type": "integer", "minimum": 0 }
        },
        "required": [
          "provider",
          "input_token_semantics",
          "input_tokens",
          "uncached_input_tokens",
          "output_tokens",
          "total_tokens"
        ],
        "additionalProperties": false
      }
    },
    "configured_usage_estimate": {
      "type": ["object", "null"],
      "properties": {
        "amount": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?$" },
        "unit": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "enum": ["configured_usage_pricing"] },
        "pricing_source": { "type": "string", "minLength": 1 },
        "pricing_effective_at": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "service_tier": { "type": "string", "minLength": 1 },
        "billing_mode": { "type": "string", "minLength": 1 },
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "uncached_input_tokens",
                  "cache_read_input_tokens",
                  "cache_write_input_tokens",
                  "cache_write_5m_input_tokens",
                  "cache_write_1h_input_tokens",
                  "output_tokens",
                  "requests"
                ]
              },
              "quantity": { "type": "integer", "minimum": 0 },
              "rate": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?$" },
              "rate_denominator": { "type": "integer", "minimum": 1 },
              "amount": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?$" }
            },
            "required": ["category", "quantity", "rate", "rate_denominator", "amount"],
            "additionalProperties": false
          }
        }
      },
      "required": ["amount", "unit", "basis", "pricing_source", "line_items"],
      "additionalProperties": false
    },
    "submission_status": { "type": "string", "enum": ["valid", "malformed", "missing"] },
    "unscored_novel_strategy": { "type": "boolean" },
    "supersedes_trial_id": { "type": ["string", "null"] },
    "recorded_at": { "type": "string" }
  },
  "$defs": {
    "operationStatus": {
      "type": "string",
      "enum": ["ok", "error", "skipped", "unsupported"]
    },
    "dimensionResult": {
      "type": "object",
      "required": ["applicable", "outcome", "grader_result_ids"],
      "properties": {
        "applicable": { "type": "boolean" },
        "outcome": {
          "type": "string",
          "enum": ["pass", "fail", "partial", "abstain", "no_result"]
        },
        "accepted_fact_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "grader_result_ids": { "type": "array", "items": { "type": "string" } },
        "invalidity_reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
