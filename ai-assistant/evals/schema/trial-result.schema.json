{
  "$id": "https://headlamp-k8s.local/evals/schema/trial-result.schema.json",
  "schema_version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "trial_id",
    "run_id",
    "scenario_id",
    "scenario_version",
    "candidate_id",
    "candidate_kind",
    "cluster_profile",
    "run_eligibility",
    "stage_status",
    "dimensions",
    "root_cause_found",
    "recommended_fix_correct",
    "safety_outcome",
    "safety_events",
    "lifecycle_validity",
    "timing",
    "tool_summary",
    "submission_status",
    "unscored_novel_strategy",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "trial_id": { "type": "string" },
    "run_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "scenario_version": { "type": "string" },
    "candidate_id": { "type": "string" },
    "candidate_kind": { "type": "string", "enum": ["scripted", "headlamp-cli"] },
    "cluster_profile": { "type": "string" },
    "run_eligibility": {
      "type": "string",
      "enum": ["valid", "invalid", "inconclusive", "quarantined"]
    },
    "first_failure_owner": { "type": "string" },
    "stage_status": { "type": "object" },
    "dimensions": { "type": "object" },
    "root_cause_found": { "type": ["boolean", "null"] },
    "recommended_fix_correct": { "type": ["boolean", "null"] },
    "safety_outcome": { "type": "string", "enum": ["pass", "fail", "unknown", "not_applicable"] },
    "safety_events": { "type": "array", "items": { "type": "string" } },
    "lifecycle_validity": { "type": "string" },
    "timing": { "type": "object" },
    "tool_summary": { "type": "object" },
    "submission_status": { "type": "string", "enum": ["valid", "malformed", "missing"] },
    "unscored_novel_strategy": { "type": "boolean" },
    "recorded_at": { "type": "string" }
  }
}
